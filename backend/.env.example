# ===========================================
# AI Studio 后端环境配置示例
# ===========================================
# 复制此文件为 .env 并修改相应配置
# 或直接在系统环境变量中设置

# ------------------------------------------
# API 密钥配置
# ------------------------------------------
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ------------------------------------------
# 数据库配置（PostgreSQL）
# 推荐优先级：环境变量 > settings.json > 默认值
# ------------------------------------------

# 方式一：完整连接 URL（推荐 Docker/K8s/云服务使用）
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_studio

# 方式二：单独的数据库参数（推荐本地开发使用）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ai_studio
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# ------------------------------------------
# 可选配置
# ------------------------------------------
# SQL_ECHO=true  # 打印 SQL 语句，用于调试

# ===========================================
# 快速启动 PostgreSQL（Docker）
# ===========================================
# docker run -d \
#   --name ai-studio-db \
#   -e POSTGRES_DB=ai_studio \
#   -e POSTGRES_USER=postgres \
#   -e POSTGRES_PASSWORD=your_password_here \
#   -p 5432:5432 \
#   postgres:15-alpine

# ===========================================
# 不同系统的环境变量设置方法
# ===========================================

# Linux/macOS (临时生效)：
#   export DB_PASSWORD=your_password
#   python3 -m uvicorn app.main:app --reload

# Linux/macOS (永久生效)：
#   将配置写入 ~/.bashrc 或 ~/.zshrc

# Windows CMD (临时生效)：
#   set DB_PASSWORD=your_password
#   python -m uvicorn app.main:app --reload

# Windows PowerShell (临时生效)：
#   $env:DB_PASSWORD="your_password"
#   python -m uvicorn app.main:app --reload

# Docker Compose：
#   在 docker-compose.yml 中指定 environment 或 .env 文件